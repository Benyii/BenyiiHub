# ─── Discord ────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# CLIENT_ID es el que realmente usa src/config/config.js (application id)
CLIENT_ID=
CLIENT_SECRET=

# Si se define, `npm run deploy-commands` registra los slash commands SOLO
# en este servidor (rápido para desarrollo). Vacío = registro global.
GUILD_ID_DEV=

# ─── MySQL / MariaDB ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=discord_bot

# ─── Logs ──────────────────────────────────────────────────
# error | warn | info | debug   (por defecto: info)
LOG_LEVEL=info
LOG_CHANNEL_ID=

# ─── Canales de voz "join to create" (sistema antiguo) ─────
JTC_CHANNEL_ID=
JTC_CATEGORY_ID=
JTC_USER_LIMIT=4

# ─── Twitch ────────────────────────────────────────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Segundos entre chequeos de streams (por defecto: 60)
TWITCH_POLL_INTERVAL=60

# ─── Permisos ──────────────────────────────────────────────
# IDs de usuario separados por coma. Si hay al menos uno, SOLO estos IDs
# pueden usar los comandos de la carpeta commands/admin (override global).
SUPERADMIN=

# IDs de rol separados por coma: staff que ve los tickets de reclutamiento.
TICKET_STAFF_ROLES=
# IDs de rol separados por coma: roles que puede otorgar el flujo de reclutamiento.
RECRUIT_ACCEPT_ROLES=
